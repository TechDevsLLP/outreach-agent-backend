# MongoDB
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_DATABASE=outflo_v3

# JWT Auth
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440
SESSION_COOKIE_SECURE=false

# Apify
APIFY_API_KEY=
APIFY_COMPANY_SCRAPER_ID=UwSdACBp7ymaGUJjS
APIFY_POST_SCRAPER_ACTOR_ID=r4oNX7IHlW4RQAjKP

# GrowthToolkit (email finder / phone unlock)
GROWTHTOOLKIT_API_KEY=
GROWTHTOOLKIT_BASE_URL=https://api.appconnector.pro

# AI (OpenRouter + Gemini)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEMINI_API_KEY=
CLAUDE_MODEL=anthropic/claude-sonnet-4-5
OUTREACH_MODEL=google/gemini-2.5-flash

# Email — platform default sender identity (used as a fallback label only;
# actual sending is per-account via Gmail API / Zoho Mail API / custom SMTP+IMAP)
SENDER_EMAIL=neel@mentopreneur.com
SENDER_NAME=Mentor Neel Shah
REPLY_TO_EMAIL=

# Credential encryption at rest (Fernet key for OAuth tokens + SMTP/IMAP passwords)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# LinkedIn — Unipile
UNIPILE_TOKEN=
UNIPILE_BASE_URL=https://api29.unipile.com:15901/api/v1
UNIPILE_WEBHOOK_SECRET=

# Google OAuth (per-user Gmail accounts)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Zoho Mail OAuth (per-user Zoho accounts)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:3000/api/auth/zoho/callback

# Application
APP_ENV=development
APP_ROLE=all
ENRICHMENT_STARTUP_SWEEP_ENABLED=false
DEBUG=true
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8008
API_BASE_URL=http://localhost:8008
# Comma-separated extra CORS origins, e.g. "http://localhost:3000,https://app.example.com"
CORS_ORIGINS=
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
MAX_REQUEST_BYTES=10485760

# Super admin (platform-level) — single email allowlist
SUPER_ADMIN_EMAIL=

# Quality gates
QUALITY_GATES_ENABLED=true
TITLE_GATE_ENABLED=true
PREFILTER_GATE_ENABLED=true

# Discovery logging
DISCOVERY_LOG_DIR=logs/campaigns

# Cost tracking
COST_TRACKING_ENABLED=true
