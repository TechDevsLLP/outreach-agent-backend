# AI (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CLAUDE_MODEL=anthropic/claude-sonnet-4.5
OUTREACH_MODEL=google/gemini-2.5-flash

# Email — SendGrid (Neil's default)
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_SECRET=
SENDER_EMAIL=neel@mentopreneur.com
SENDER_NAME=Mentor Neel Shah
REPLY_TO_EMAIL=

# LinkedIn — Unipile
UNIPILE_TOKEN=
UNIPILE_BASE_URL=https://api29.unipile.com:15901/api/v1
UNIPILE_WEBHOOK_SECRET=

# Google OAuth (per-user Gmail accounts)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/email-accounts?provider=google

# Microsoft OAuth (per-user Outlook accounts)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/email-accounts?provider=microsoft

# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

# Legacy single-admin (deprecated — kept for backward compat)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Quality gates
QUALITY_GATES_ENABLED=true
TITLE_GATE_ENABLED=true
FRESHNESS_GATE_ENABLED=true
PREFILTER_GATE_ENABLED=true

# AI prefilter
PREFILTER_MODEL=google/gemini-3-flash-preview
PREFILTER_BATCH_SIZE=20
PREFILTER_CONCURRENCY=4
PREFILTER_CONFIDENCE_THRESHOLD=0.4

# Freshness check
FRESHNESS_SHORT_MODE=true
FRESHNESS_CONCURRENCY=8

# Discovery logging
DISCOVERY_LOG_DIR=logs/campaigns

# Cost tracking
COST_TRACKING_ENABLED=true
