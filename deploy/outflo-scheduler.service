[Unit]
Description=OutFlo Scheduler Worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=outflo
Group=outflo
WorkingDirectory=/opt/outflo/current/backend
EnvironmentFile=/etc/outflo/outflo.env
Environment=APP_ROLE=scheduler
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/outflo/shared/venv/bin/python -m scheduler_worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/outflo/shared /opt/outflo/current/backend/logs
RestrictSUIDSGID=true
LockPersonality=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
