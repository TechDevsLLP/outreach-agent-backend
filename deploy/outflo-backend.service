[Unit]
Description=OutFlo Backend (FastAPI)
After=network.target

[Service]
Type=simple
User=outflo
Group=outflo
WorkingDirectory=/opt/outflo/backend
EnvironmentFile=-/opt/outflo/backend/.env
Environment=APP_ROLE=web
ExecStart=/opt/outflo/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8008
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
